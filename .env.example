# Core application
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/meste?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/meste?sslmode=require
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudflare R2 — leave every R2 value empty for local filesystem storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

# Transactional email (Phase 6)
RESEND_API_KEY=
FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Optional monitoring (Phase 7/8)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
